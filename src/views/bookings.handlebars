<header class="page-heading">
  <div>
    <p class="eyebrow">Agenda</p>
    <h1>Reservas y turnos</h1>
    <p class="lede">Información actualizada desde la base de datos.</p>
  </div>
  <p class="count-chip">{{bookings.length}} turnos</p>
</header>

<section id="bookings-list" class="booking-list" aria-live="polite">
  {{#if bookings.length}}
    {{#each bookings}}
      <article class="card booking-card" data-booking-id="{{_id}}">
        <div class="card-topline">
          <span class="status status-{{status}}">{{status}}</span>
          <time class="schedule" datetime="{{date}}T{{time}}">{{date}} · {{time}}</time>
        </div>
        <div class="client-block">
          <h2>{{clientName}}</h2>
          <p class="client-email">{{clientEmail}}</p>
        </div>
        <div class="service-block">
          <h3>Servicios</h3>
          {{#if services.length}}
            <ul class="service-items">
              {{#each services}}
                <li>
                  <span>{{service.name}}</span>
                  <strong>× {{quantity}}</strong>
                </li>
              {{/each}}
            </ul>
          {{else}}
            <p class="muted">Sin servicios asociados.</p>
          {{/if}}
        </div>
        {{#unless (eq status "confirmada")}}
          <div class="card-actions">
            <button type="button" class="btn confirm-booking-btn" data-booking-id="{{_id}}">Confirmar reserva</button>
          </div>
        {{/unless}}
      </article>
    {{/each}}
  {{else}}
    <p id="empty-bookings" class="empty-state">No hay reservas registradas.</p>
  {{/if}}
</section>
