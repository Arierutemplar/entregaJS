# Puerto HTTP del servidor
PORT=8080
# Cadena de conexión a MongoDB
MONGO_URL=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base_de_datos>?retryWrites=true&w=majority
# Clave para firmar JWT; usar un valor largo y aleatorio
JWT_SECRET=<clave-larga-y-aleatoria>
# Duración de los JWT, por ejemplo 1h
JWT_EXPIRES_IN=1h
# development | production | test
NODE_ENV=development
