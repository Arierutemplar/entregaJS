# Puerto HTTP del servidor
PORT=8080
# development | production | test
NODE_ENV=development
# Cadena de conexión a MongoDB (MONGO_URI se acepta como alias)
MONGO_URL=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base_de_datos>?retryWrites=true&w=majority
# Clave para firmar JWT (entregas posteriores); usar un valor largo y aleatorio
JWT_SECRET=<clave-larga-y-aleatoria>
# Duración de los JWT (entregas posteriores), por ejemplo 1h
JWT_EXPIRES_IN=1h
# Opcional: servidores DNS usados al conectar con MongoDB Atlas
# DNS_SERVERS=1.1.1.1,8.8.8.8
# Opcional: base de datos de pruebas independiente para npm test.
# TEST_MONGO_URL=mongodb://127.0.0.1:27017/plataforma_eventos_test
